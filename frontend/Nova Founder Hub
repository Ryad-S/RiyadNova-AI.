 RiyadNova AI
 Nova Founder Hub Interface
 Founder Workspace System v1.0

========================================================= */


/* ==========================
   Layout الرئيسي
========================== */


.founder-layout{

display:grid;

grid-template-columns:

280px 1fr;

min-height:100vh;

gap:25px;

padding:25px;

}





/* ==========================
   Sidebar المؤسس
========================== */


.founder-sidebar{


background:

rgba(255,255,255,.05);


border:

1px solid var(--border-soft);


border-radius:

32px;


padding:25px;


height:calc(100vh - 50px);


position:sticky;


top:25px;


}



.founder-profile{


display:flex;


align-items:center;


gap:15px;


padding-bottom:25px;


border-bottom:

1px solid var(--border-soft);


}



.profile-avatar{


width:65px;


height:65px;


border-radius:50%;


background:

var(--nova-gradient);


display:flex;


align-items:center;


justify-content:center;


font-size:25px;


font-weight:900;


}




.founder-menu{


margin-top:25px;


}



.founder-menu-item{


display:flex;


align-items:center;


gap:15px;


padding:16px;


border-radius:18px;


color:var(--text-soft);


cursor:pointer;


transition:.3s;


}



.founder-menu-item:hover,


.founder-menu-item.active{


background:

rgba(0,229,255,.12);


color:

var(--rn-cyan);


}





/* ==========================
   منطقة المحتوى
========================== */


.founder-content{


display:flex;


flex-direction:column;


gap:25px;


}





/* ==========================
   Header Dashboard
========================== */


.founder-header{


display:flex;


align-items:center;


justify-content:space-between;


padding:30px;


border-radius:30px;


background:

rgba(255,255,255,.05);


border:

1px solid var(--border-soft);


}



.project-status{


display:flex;


align-items:center;


gap:12px;


}



.status-circle{


width:12px;


height:12px;


border-radius:50%;


background:

var(--rn-mint);


box-shadow:

0 0 20px var(--rn-mint);


}





/* ==========================
   بطاقة المشروع
========================== */


.project-overview{


display:grid;


grid-template-columns:

repeat(4,1fr);


gap:20px;


}



.project-card{


padding:25px;


border-radius:28px;


background:

rgba(255,255,255,.06);


border:

1px solid var(--border-soft);


}



.project-number{


font-size:38px;


font-weight:900;


color:

var(--rn-cyan);


}





/* ==========================
   فريق الذكاء الاصطناعي
========================== */


.ai-team{


display:grid;


grid-template-columns:

repeat(5,1fr);


gap:20px;


}



.ai-member{


text-align:center;


padding:25px;


}



.ai-member-icon{


width:70px;


height:70px;


margin:auto;


border-radius:24px;


background:

var(--nova-gradient);


display:flex;


align-items:center;


justify-content:center;


font-size:30px;


}





/* ==========================
   مساعد المؤسس
========================== */


.co-founder-chat{


display:grid;


grid-template-columns:

1fr 350px;


gap:25px;


}



.chat-window{


height:600px;


border-radius:35px;


background:

rgba(255,255,255,.05);


border:

1px solid var(--border-soft);


display:flex;


flex-direction:column;


}



.chat-header{


padding:25px;


border-bottom:

1px solid var(--border-soft);


display:flex;


align-items:center;


gap:15px;


}



.ai-thinking{


display:flex;


gap:6px;


}



.ai-thinking span{


width:8px;


height:8px;


border-radius:50%;


background:

var(--rn-cyan);


animation:

thinking 1.5s infinite;


}



.ai-thinking span:nth-child(2){

animation-delay:.2s;

}



.ai-thinking span:nth-child(3){

animation-delay:.4s;

}



@keyframes thinking{


50%{

opacity:.3;

transform:translateY(-5px);

}


}





/* ==========================
   القرارات الذكية
========================== */


.decision-panel{


padding:30px;


border-radius:30px;


}



.decision-item{


padding:20px;


margin-bottom:15px;


border-radius:20px;


background:

rgba(255,255,255,.05);


border:

1px solid var(--border-soft);


}



.decision-high{


border-color:

var(--rn-mint);


}



.decision-warning{


border-color:

var(--rn-gold);


}





/* ==========================
   تقارير المشروع
========================== */


.report-grid{


display:grid;


grid-template-columns:

repeat(3,1fr);


gap:25px;


}



.report-card{


padding:30px;


}



.score{


font-size:55px;


font-weight:900;


background:

var(--nova-gradient);


-webkit-background-clip:text;


color:transparent;


}





/* ==========================
   شريط التقدم
========================== */


.project-progress{


height:15px;


background:

rgba(255,255,255,.1);


border-radius:50px;


overflow:hidden;


}



.project-progress span{


height:100%;


display:block;


width:65%;


background:

var(--nova-gradient);


}





/* ==========================
   Responsive
========================== */


@media(max-width:1200px){


.founder-layout{


grid-template-columns:1fr;


}



.founder-sidebar{


position:relative;


height:auto;


}



.ai-team{


grid-template-columns:

repeat(3,1fr);


}



.project-overview{


grid-template-columns:

repeat(2,1fr);


}



}



@media(max-width:700px){


.ai-team,

.project-overview,

.report-grid{


grid-template-columns:1fr;


}



.co-founder-chat{


grid-template-columns:1fr;


}


}
